{
  "name": "@beangle/bui-vue",
  "version": "0.0.6-dev",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/data-grid.css": "./src/styles/data-grid.css",
    "./styles/table.css": "./src/styles/table.css",
    "./styles/query-form.css": "./src/styles/query-form.css",
    "./styles/workbench.css": "./src/styles/workbench.css",
    "./styles/underline-tabs.css": "./src/styles/underline-tabs.css",
    "./styles/drawer-form.css": "./src/styles/drawer-form.css",
    "./styles/side-nav.css": "./src/styles/side-nav.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "prepublishOnly": "pnpm run build",
    "release:prepare": "bash scripts/release-prepare.sh",
    "release:finish": "bash scripts/release-finish.sh",
    "release:dev": "bash scripts/release-dev.sh",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "publishLocal": "bash scripts/publish-local.sh"
  },
  "peerDependencies": {
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1"
  }
}
